opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/ppx_hash"
bug-reports: "https://github.com/public-release-reloaded/ppx_hash/issues"
dev-repo: "git+https://github.com/public-release-reloaded/ppx_hash.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/ppx_hash/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base_internalhash_types" {>= "v0.18~" & < "v0.19~"}
  "ppx_compare" {>= "v0.18~" & < "v0.19~"}
  "ppx_helpers" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_conv" {>= "v0.18~" & < "v0.19~"}
  "ppxlib_jane" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "ocaml-compiler-libs" {>= "v0.11.0"}
  "ppxlib" {> "0.38.0"}
]
available: arch != "x86_32"
synopsis: "A ppx rewriter that generates hash functions from type expressions and definitions"
description: "
Part of the Jane Street's PPX rewriters collection.
"
